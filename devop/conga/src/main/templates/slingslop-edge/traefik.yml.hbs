# Static Traefik configuration. Generated by CONGA — do not edit by hand.
# Modelled on ops/ansible/roles/traefik/templates/traefik.yml.j2.

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log
  format: common
  bufferingSize: 100

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
{{#if acme}}
      tls:
        certResolver: letsencrypt
{{else}}
      # ACME disabled (local/self-signed): Traefik serves its built-in
      # self-signed default certificate for all websecure routers.
      tls: {}
{{/if}}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: {{dockerNetwork}}

{{#if acme}}
certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{acmeEmail}}"
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web
{{/if}}
