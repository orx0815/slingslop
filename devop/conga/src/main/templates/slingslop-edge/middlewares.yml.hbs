# Shared Traefik middlewares. Generated by CONGA — do not edit by hand.
# Modelled on the middlewares section of
# ops/ansible/roles/traefik/templates/dynamic.yml.j2.

http:
  middlewares:

    sec-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: strict-origin-when-cross-origin
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true

    editor-basicauth:
      basicAuth:
        usersFile: /run/secrets/editor.htpasswd
        realm: "Slingslop editor"
        removeHeader: true
