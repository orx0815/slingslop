vcl 4.1;

# Varnish config for a single public-cached Slingslop app.
# Generated by CONGA from tenant params — do not edit by hand.
# Serves {{subdomain}}.{{domain}} -> Sling content root {{contentRoot}}.

backend {{tenant}} {
    .host = "sling";
    .port = "8080";
    .connect_timeout = 10s;
    .first_byte_timeout = 60s;
}

sub vcl_recv {
    if (req.http.host == "{{subdomain}}.{{domain}}"{{#each serverAliases}} || req.http.host == "{{this}}"{{/each}}) {
        set req.backend_hint = {{tenant}};

        # Inbound short-URL re-expansion: prepend the content root unless the
        # request already carries it (mirrors the Apache ProxyPassMatch rule).
        if (req.url == "/") {
            set req.url = "{{contentRoot}}/{{homePage}}.html";
        } else if (req.url !~ "^(/content)?{{shortContentPath}}"
                && req.url !~ "^{{appsRoot}}"
                && req.url !~ "^/(favicon\.ico|\.well-known)") {
            set req.url = "{{contentRoot}}" + req.url;
        }

        # Cache one entry per path, ignoring the query string (cache-buster-safe,
        # query-string-DoS-immune — same policy as the Apache variant).
        set req.url = regsub(req.url, "\?.*$", "");
    }
}

sub vcl_backend_response {
    set beresp.ttl = 10s;
    set beresp.grace = 1h;
}
