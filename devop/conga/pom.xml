<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.motorbrot</groupId>
    <artifactId>slingslop.parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>slingslop.devop.conga</artifactId>
  <!-- CONGA 'config' packaging: this module both declares the role/template
       definitions (src/main/roles + src/main/templates) AND the environments
       (src/main/environments), and runs conga:generate to render config for
       every node. See docs/conga-config-generation-concept.md -->
  <packaging>config</packaging>

  <name>Slingslop - devop - CONGA config generator</name>
  <description>Generates reverse-proxy, webcache, Sling URL-mapping and launcher
    config for each public-facing Slingslop app (one CONGA tenant per app).</description>

  <properties>
    <conga.plugin.version>1.20.0</conga.plugin.version>
    <conga.plugins.sling.version>1.6.0</conga.plugins.sling.version>
    <conga.plugins.ansible.version>1.6.0</conga.plugins.ansible.version>
    <!-- This module renders text config only; nothing to deploy to Sling. -->
    <sling.install.skip>true</sling.install.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>io.wcm.devops.conga</groupId>
        <artifactId>conga-maven-plugin</artifactId>
        <version>${conga.plugin.version}</version>
        <!-- extensions=true enables the custom 'config' packaging lifecycle -->
        <extensions>true</extensions>
        <dependencies>
          <!-- Sling plugin: OSGi .cfg.json / Feature Model file handling + validators -->
          <dependency>
            <groupId>io.wcm.devops.conga.plugins</groupId>
            <artifactId>io.wcm.devops.conga.plugins.sling</artifactId>
            <version>${conga.plugins.sling.version}</version>
          </dependency>
          <!-- Ansible plugin: lets ops keep secrets/inventory in the existing
               ansible vault and have CONGA read them at generate-time.
               Declared here; wiring the vault value-provider is a later step. -->
          <dependency>
            <groupId>io.wcm.devops.conga.plugins</groupId>
            <artifactId>io.wcm.devops.conga.plugins.ansible</artifactId>
            <version>${conga.plugins.ansible.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

</project>
