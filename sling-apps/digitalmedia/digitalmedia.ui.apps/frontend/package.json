{
  "name": "digitalmedia-ui-apps",
  "version": "0.0.1-SNAPSHOT",
  "description": "TypeScript sources for Digital Media Library (DML) UI",
  "private": true,
  "scripts": {
    "build": "node scripts/bundle.js",
    "watch": "node scripts/bundle.js --watch",
    "typecheck": "tsc --noEmit",
    "copy:htmx": "cpx \"node_modules/htmx.org/dist/htmx.js\" \"../src/main/content/jcr_root/apps/motorbrot/dma/js\"",
    "copy:libs": "npm run copy:htmx",
    "prebuild": "npm run copy:htmx",
    "lint": "eslint src/typescript",
    "lint:fix": "eslint src/typescript --fix",
    "format": "prettier --check \"./src/typescript/**/*.ts\"",
    "format:fix": "prettier --write \"./src/typescript/**/*.ts\"",
    "check": "npm run format && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "htmx.org": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.17",
    "cpx2": "^7.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
