# nginx proxy_cache server for a single public-cached Slingslop app.
# Generated by CONGA from tenant params — do not edit by hand.
#
# Reads the SAME shared tenant params as the apache/varnish variants
# (roles/slingslop-app-base.yaml). Regex alternations use a never-matching `$^`
# seed so an empty list renders a harmless "matches nothing" group.

proxy_cache_path /var/cache/nginx/{{tenant}} levels=1:2 keys_zone={{tenant}}:10m max_size=1g inactive=30d use_temp_path=off;

server {
    listen 80;
    server_name {{subdomain}}.{{domain}}{{#each serverAliases}} {{this}}{{/each}};

    add_header X-Content-Type-Options nosniff   always;
    add_header X-Frame-Options        SAMEORIGIN always;
    add_header X-Cache-Status         $upstream_cache_status always;

    # ── Security filtering (the app's front-line protection) ────────────────
    # Method allow-list.
    if ($request_method !~ ^(?:$^{{#each allowedMethods}}|{{this}}{{/each}})$) { return 405; }
    # Dangerous selectors / views, numbered json dumps and internal trees.
    if ($uri ~* "\.(?:$^{{#each denySelectors}}|{{this}}{{/each}})\.")  { return 403; }
    if ($uri ~  "\.[0-9]+\.json")                                       { return 403; }
    # Internal trees → 403, EXCEPT paths allow-listed via passthroughPaths
    # (e.g. /bin/public for the clientlib servlet). nginx `if` has no AND, so
    # combine flags like the .json allow-list below.
    set $denyflag "";
    if ($uri ~* "^/(?:$^{{#each denyPathPrefixes}}|{{this}}{{/each}})/") { set $denyflag "deny"; }
{{#each passthroughPaths}}
    if ($uri ~ "^{{this}}/") { set $denyflag "${denyflag}-ok"; }
{{/each}}
    if ($denyflag = "deny") { return 403; }

    # .json RESOURCE extension only under an allow-listed prefix (true ext,
    # ignoring any /suffix). nginx `if` has no AND, so combine flags.
    set $sling_ext "";
    if ($uri ~ "^.*?\.([A-Za-z0-9]+)(?:/.*)?$") { set $sling_ext $1; }
    set $jflag "";
    if ($sling_ext = "json") { set $jflag "json"; }
{{#each jsonAllowlist}}
    if ($uri ~* "^{{this}}") { set $jflag "${jflag}-ok"; }
{{/each}}
    if ($jflag = "json") { return 403; }

    # ── Shared cache policy (inherited by every location) ────────────────────
    proxy_cache        {{tenant}};
    # Key excludes $args → one entry per path (cache-buster-safe, query-DoS-safe).
    proxy_cache_key    "$scheme$request_method$host$uri";
    proxy_cache_lock   on;                 # collapse concurrent misses (stampede guard)
    proxy_cache_use_stale updating error timeout http_500 http_502 http_503;
    proxy_cache_background_update on;

    # UNCACHED patterns → bypass the cache, always fetch fresh from Sling.
    set $nocache 0;
{{#each uncachedPatterns}}
    if ($uri ~ "{{this}}") { set $nocache 1; }
{{/each}}
    proxy_cache_bypass $nocache;
    proxy_no_cache     $nocache;

    proxy_set_header   Host $host;
    # ProxyPassReverse equivalent — strip the internal backend host from 30x.
    proxy_redirect     http://sling:8080/ /;
    proxy_ignore_headers Cache-Control Expires Set-Cookie;

    # Allow list: paths reaching Sling UNREWRITTEN ({{appsRoot}} + passthroughPaths).
    location {{appsRoot}}/ {
        proxy_pass http://sling:8080{{appsRoot}}/;
        proxy_cache_valid 200 {{staticTtlSeconds}}s;
        expires {{staticTtlSeconds}}s;
    }
{{#each passthroughPaths}}
    location {{this}}/ {
        proxy_pass http://sling:8080{{this}}/;
    }
{{/each}}

    location = / {
        proxy_pass http://sling:8080{{contentRoot}}/{{homePage}}.html;
        proxy_cache_valid 200 {{htmlTtlSeconds}}s;
    }

    location {{contentRoot}}/ {
        proxy_pass http://sling:8080{{contentRoot}}/;
        proxy_cache_valid 200 {{htmlTtlSeconds}}s;
    }

    # Inbound short-URL re-expansion: prepend the content root.
    location / {
        proxy_pass http://sling:8080{{contentRoot}}$uri;
        proxy_cache_valid 200 {{htmlTtlSeconds}}s;
    }
}
