# Apache mod_cache + mod_proxy vhost for a single public-cached Slingslop app.
# Generated by CONGA from tenant params — do not edit by hand.
# Modelled on devops/ansible/roles/webcache/templates/zengarden.conf.j2.
#
# The security + cache knobs below come from the SHARED tenant params defined in
# roles/slingslop-app-base.yaml — the varnish and nginx variants read the exact
# same params. Regex alternations use a never-matching `$^` seed so an empty
# list renders a harmless "matches nothing" group.

<VirtualHost *:80>

   ServerName {{subdomain}}.{{domain}}
{{#each serverAliases}}
   ServerAlias {{this}}
{{/each}}
   DocumentRoot /var/www/vhosts/{{subdomain}}
   ErrorLog /var/log/apache2/{{subdomain}}-err.log
   TransferLog /var/log/apache2/{{subdomain}}-access.log
   DirectoryIndex index.html

   RewriteEngine on

   # ── Security filtering (the app's front-line protection) ─────────────────
   # Method allow-list — reject anything not in allowedMethods (POST/DELETE/…).
   RewriteCond %{REQUEST_METHOD} !^(?:$^{{#each allowedMethods}}|{{this}}{{/each}})$ [NC]
   RewriteRule .* - [F,L]

   # Dangerous Sling selectors / views (.infinity. .tidy. …) → 403.
   RewriteRule "\.(?:$^{{#each denySelectors}}|{{this}}{{/each}})\." - [F,L,NC]
   # Numbered JSON tree dumps (.10.json) → 403.
   RewriteRule "\.[0-9]+\.json" - [F,L]
   # Internal JCR trees (/system /bin …) → 403 — EXCEPT paths the operator
   # explicitly allow-listed via passthroughPaths (e.g. /bin/public for the
   # cache-busting clientlib servlet), which must reach Sling unrewritten.
{{#each passthroughPaths}}
   RewriteCond %{REQUEST_URI} !^{{this}}/
{{/each}}
   RewriteRule "^/(?:$^{{#each denyPathPrefixes}}|{{this}}{{/each}})/" - [F,L,NC]

   # Compute the TRUE Sling extension (first .ext before any /suffix) into an
   # env var, then allow a `.json` extension only under an allow-listed prefix.
   RewriteRule "^/?[^?]*?\.([A-Za-z0-9]+)(?:/.*)?$" - [E=SLING_EXT:$1]
   RewriteCond %{ENV:SLING_EXT} =json
{{#each jsonAllowlist}}
   RewriteCond %{REQUEST_URI} !^{{this}}
{{/each}}
   RewriteRule .* - [F,L]

   # ── Never-cache patterns (uncachedPatterns) ──────────────────────────────
   # Flag matching requests; the response is marked no-store below so mod_cache
   # skips storing it (CacheStoreNoStore is Off by default).
{{#each uncachedPatterns}}
   SetEnvIf Request_URI "{{this}}" SLING_NOCACHE=1
{{/each}}

   RewriteRule "^{{contentRoot}}(.*)$" "$1" [PT]

   # Configure mod_cache
   CacheEnable disk /
   CacheIgnoreNoLastMod On
   CacheIgnoreCacheControl On
   # Cache one entry per PATH, ignoring the query string. The full request
   # (incl. query) is still forwarded to Sling on a MISS, so Sling sees the
   # params — but every ?v=... (ours) and ?x=rnd (attacker) shares one cache
   # entry: cache-buster-safe AND immune to query-string cache-bypass DoS.
   CacheIgnoreQueryString On
   CacheRoot /var/cache/httpd/slingslop
   CacheDefaultExpire {{htmlTtlSeconds}}
   CacheHeader On
   CacheDetailHeader On

   # Responses flagged SLING_NOCACHE carry no-store, so mod_cache does not store
   # them (CacheStoreNoStore Off by default) — always fresh from Sling.
   Header always set Cache-Control "no-store" env=SLING_NOCACHE

   # Configure mod_expire
   ExpiresActive On
   ExpiresDefault "access plus {{staticTtlSeconds}} seconds"
   ExpiresByType text/html "access plus {{htmlTtlSeconds}} seconds"
   ExpiresByType application/json "access plus {{htmlTtlSeconds}} seconds"
   ExpiresByType image/gif "access plus {{staticTtlSeconds}} seconds"
   ExpiresByType image/jpeg "access plus {{staticTtlSeconds}} seconds"
   ExpiresByType image/png "access plus {{staticTtlSeconds}} seconds"
   ExpiresByType text/css "access plus {{cssJsTtlSeconds}} seconds"
   ExpiresByType text/javascript "access plus {{cssJsTtlSeconds}} seconds"
   ExpiresByType application/javascript "access plus {{cssJsTtlSeconds}} seconds"

   # Configure Proxy
   ProxyPassInterpolateEnv On
   ProxyPass /.well-known !
   ProxyPass /ERROR !

   # Allow-list: paths reaching Sling unrewritten ({{appsRoot}} + passthroughPaths)
   ProxyPass {{appsRoot}}/ http://${RENDERER_URL}:8080{{appsRoot}}/ connectiontimeout=10 timeout=60 retry=0 interpolate
{{#each passthroughPaths}}
   ProxyPass {{this}}/ http://${RENDERER_URL}:8080{{this}}/ connectiontimeout=10 timeout=60 retry=0 interpolate
{{/each}}
   ProxyPass /favicon.ico http://${RENDERER_URL}:8080{{appsRoot}}/favicon.ico connectiontimeout=10 timeout=60 retry=0 interpolate

   # Without path -> {{homePage}}.html
   ProxyPassMatch "^/$" "http://${RENDERER_URL}:8080{{contentRoot}}/{{homePage}}.html" connectiontimeout=10 timeout=60 retry=0 interpolate

   # When path does NOT start with {{contentRoot}}, assume URL shortening has
   # worked and make it long again before requesting Sling
   ProxyPassMatch "^(?!(\/content)?{{shortContentPath}})/(.*)" "http://${RENDERER_URL}:8080{{contentRoot}}/$2" connectiontimeout=10 timeout=60 retry=0 interpolate

   ProxyPass {{contentRoot}}/ http://${RENDERER_URL}:8080{{contentRoot}}/ connectiontimeout=10 timeout=60 retry=0 interpolate
   ProxyPass {{shortContentPath}}/         http://${RENDERER_URL}:8080{{contentRoot}}/ connectiontimeout=10 timeout=60 retry=0 interpolate
   ProxyPassReverse {{contentRoot}}/ http://${RENDERER_URL}:8080{{contentRoot}}/ interpolate
   ProxyPassReverse /{{homePage}}.html/404 http://${RENDERER_URL}:8080/system/sling/form/login interpolate

   # Security / Hardening — response headers.
   AllowEncodedSlashes on
   Header set X-Frame-Options SAMEORIGIN
   Header set X-XSS-Protection "1; mode=block"
   Header set X-Content-Type-Options "nosniff"

   AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json

</VirtualHost>
