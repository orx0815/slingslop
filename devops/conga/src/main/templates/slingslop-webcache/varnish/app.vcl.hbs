vcl 4.1;

# Varnish config for a single public-cached Slingslop app.
# Generated by CONGA from tenant params — do not edit by hand.
# Serves {{subdomain}}.{{domain}} -> Sling content root {{contentRoot}}.
#
# Reads the SAME shared tenant params as the apache/nginx variants
# (roles/slingslop-app-base.yaml). Regex alternations use a never-matching `$^`
# seed so an empty list renders a harmless "matches nothing" group.
#
# NOTE: Varnish loads ONE vcl per instance. This file is a complete VCL for a
# single tenant/host. To run several tenants on one Varnish node, compose their
# per-app blocks (backend + the host-guarded branch in vcl_recv) into a single
# outer VCL — see devops/webcache.md ("Three cache engines").

backend {{tenant}} {
    .host = "sling";
    .port = "8080";
    .connect_timeout = 10s;
    .first_byte_timeout = 60s;
}

sub vcl_recv {
    if (req.http.host == "{{subdomain}}.{{domain}}"{{#each serverAliases}} || req.http.host == "{{this}}"{{/each}}) {
        set req.backend_hint = {{tenant}};

        # ── Security filtering (the app's front-line protection) ────────────
        # Method allow-list.
        if (req.method !~ "^(?:$^{{#each allowedMethods}}|{{this}}{{/each}})$") {
            return (synth(405, "method not allowed"));
        }
        # Dangerous selectors / views, numbered json dumps and internal trees.
        if (req.url ~ "(?i)\.(?:$^{{#each denySelectors}}|{{this}}{{/each}})\."
         || req.url ~ "\.[0-9]+\.json"
         || req.url ~ "(?i)^/(?:$^{{#each denyPathPrefixes}}|{{this}}{{/each}})/") {
            return (synth(403));
        }
        # .json RESOURCE extension only under an allow-listed prefix (true ext,
        # ignoring any /suffix).
        set req.http.X-Sling-Ext = regsub(req.url, "^([^?]*?)\.([A-Za-z0-9]+)(/[^?]*)?(\?.*)?$", "\2");
        if (req.http.X-Sling-Ext == "json"
         && req.url !~ "^(?:$^{{#each jsonAllowlist}}|{{this}}{{/each}})") {
            return (synth(403));
        }

        # ── URL shortening: prepend the content root unless already present ──
        if (req.url == "/") {
            set req.url = "{{contentRoot}}/{{homePage}}.html";
        } else if (req.url !~ "^(/content)?{{shortContentPath}}"
                && req.url !~ "^{{appsRoot}}"
{{#each passthroughPaths}}
                && req.url !~ "^{{this}}"
{{/each}}
                && req.url !~ "^/(favicon\.ico|\.well-known)") {
            set req.url = "{{contentRoot}}" + req.url;
        }

        # UNCACHED patterns → never look up / store; always fetch fresh.
{{#each uncachedPatterns}}
        if (req.url ~ "{{this}}") { return (pass); }
{{/each}}

        # Anonymous public site → drop cookies so responses are cacheable.
        unset req.http.Cookie;
        return (hash);
    }
}

# Cache key ignores the query string (= CacheIgnoreQueryString). The backend
# still receives the full req.url (with query) on a MISS.
sub vcl_hash {
    hash_data(regsub(req.url, "\?.*$", ""));
    hash_data(req.http.host);
    return (lookup);
}

sub vcl_backend_response {
    # ProxyPassReverse equivalent — strip the internal backend host from 30x.
    if (beresp.http.Location) {
        set beresp.http.Location = regsub(beresp.http.Location, "^https?://sling:8080/", "/");
    }
    unset beresp.http.Set-Cookie;

    # TTLs mirror the shared htmlTtlSeconds / staticTtlSeconds params.
    if (bereq.url ~ "(?i)\.(css|js|png|jpe?g|gif|svg|woff2?)(\?|$)") {
        set beresp.ttl = {{staticTtlSeconds}}s;
    } else {
        set beresp.ttl = {{htmlTtlSeconds}}s;
    }
    set beresp.grace = 24h;          # serve stale up to 24h while revalidating
    return (deliver);
}

sub vcl_deliver {
    unset resp.http.X-Sling-Ext;
    set resp.http.X-Content-Type-Options = "nosniff";
    set resp.http.X-Frame-Options = "SAMEORIGIN";
    return (deliver);
}
