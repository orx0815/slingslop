# Traefik file-provider router for a single public Slingslop app.
# Generated by CONGA from tenant params — do not edit by hand.
# Host {{subdomain}}.{{domain}} -> backend {{backendHost}}:{{backendPort}}.

http:
  routers:
    {{tenant}}:
      rule: "Host(`{{subdomain}}.{{domain}}`){{#each serverAliases}} || Host(`{{this}}`){{/each}}"
      entryPoints:
      - websecure
      service: {{tenant}}
      middlewares:
{{#each middlewares}}
      - {{this}}@file
{{/each}}
{{#if acme}}
      tls:
        certResolver: letsencrypt
{{else}}
      tls: {}
{{/if}}

  services:
    {{tenant}}:
      loadBalancer:
        servers:
        - url: "http://{{backendHost}}:{{backendPort}}"
