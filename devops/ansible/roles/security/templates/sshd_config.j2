# Managed by Ansible — slingslop/security role.
# Hardened sshd_config. Edit via Ansible only.

Port {{ ssh_port }}
AddressFamily any
ListenAddress 0.0.0.0
{% if ipv6_enabled | bool %}
ListenAddress ::
{% endif %}

# Authentication
PermitRootLogin {{ 'prohibit-password' if (bootstrap_phase | default(false) | bool) else 'no' }}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM yes
PermitEmptyPasswords no
AuthenticationMethods publickey
MaxAuthTries 3
LoginGraceTime 20

# Modern crypto only
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,sntrup761x25519-sha512@openssh.com
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

# Behaviour
AllowUsers {{ ssh_allowed_users | join(' ') }}
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
GatewayPorts no
PrintMotd no
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE

# SFTP
Subsystem sftp /usr/lib/openssh/sftp-server
