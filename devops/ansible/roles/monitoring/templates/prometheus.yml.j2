# Managed by Ansible — slingslop/monitoring role.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:

  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  # org.apache.sling.commons.metrics.prometheus exposes the JVM + Oak + Sling
  # Dropwizard metrics registry at /metrics, unauthenticated. See
  # launcher/src/main/features/launcher.json and devops/README.md §7.
  - job_name: sling
    static_configs:
      - targets: ['slingslop:8080']
