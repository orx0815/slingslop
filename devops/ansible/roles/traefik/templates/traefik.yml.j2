# Managed by Ansible — slingslop/traefik role.

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log
  format: common
  bufferingSize: 100

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
{% if traefik_acme_enabled | default(true) | bool %}
      tls:
        certResolver: letsencrypt
{% else %}
      # ACME disabled (local/self-signed): Traefik serves its built-in
      # self-signed default certificate for all websecure routers.
      tls: {}
{% endif %}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: {{ docker_network_name }}

{% if traefik_acme_enabled | default(true) | bool %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ vault_acme_email }}"
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web
{% endif %}

{% if traefik_dashboard_enabled | default(true) | bool %}
# Dashboard exposed at https://traefik.<domain>/ via a file-provider router
# (see dynamic.yml). insecure=false keeps it off the unauthenticated :8080 API.
api:
  dashboard: true
  insecure: false
{% endif %}
