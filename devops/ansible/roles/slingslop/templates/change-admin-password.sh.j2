#!/bin/bash
# Managed by Ansible — slingslop/slingslop role.
#
# Idempotently rotate the Sling admin password to the value in the vault.
#   - If the target password already works → exit 0, print NOOP.
#   - Else try the previously-known password (file on disk), then the
#     hard-coded default "admin", until one of them works.
#   - POST to /system/userManager/user/admin.changePassword.html
#     (per https://cwiki.apache.org/confluence/display/SLING/FAQ).
#   - On success, persist the new password to /opt/slingslop/secrets/.last-admin-password
#     so the next rotation knows the "before" value.
#
# Output contract:
#   prints either "NOOP" or "CHANGED" on the last line. Exit 0 on success.

set -euo pipefail

SLING_URL="{{ sling_internal_url | default('http://127.0.0.1:18080') }}"
TARGET_PW='{{ vault_sling_admin_password }}'
LAST_PW_FILE='{{ slingslop_secrets_dir }}/.last-admin-password'

works() {
    local pw="$1"
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' \
            -u "admin:${pw}" \
            "${SLING_URL}/system/sling/info.sessionInfo.json" \
            || true)
    [ "$code" = "200" ]
}

# 1. Already the target?
if works "$TARGET_PW"; then
    echo "NOOP"
    exit 0
fi

# 2. Find a working "before" password.
#    /starter.html can answer 200 a few seconds before the admin login module /
#    JCR security is ready (notably on the seeded composite image), so retry
#    until a known password authenticates instead of failing on the first miss.
BEFORE=""
deadline=$(( $(date +%s) + {{ sling_admin_ready_timeout | default(120) }} ))
while :; do
    # Target might get set by a concurrent/previous run while we wait.
    if works "$TARGET_PW"; then
        echo "NOOP"
        exit 0
    fi
    if [ -f "$LAST_PW_FILE" ] && works "$(cat "$LAST_PW_FILE")"; then
        BEFORE="$(cat "$LAST_PW_FILE")"
        break
    elif works "admin"; then
        BEFORE="admin"
        break
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "ERROR: cannot authenticate as admin with any known password" >&2
        exit 1
    fi
    sleep 3
done

# 3. Rotate
HTTP=$(curl -s -o /tmp/sling-change.out -w '%{http_code}' \
        -u "admin:${BEFORE}" \
        -F "oldPwd=${BEFORE}" \
        -F "newPwd=${TARGET_PW}" \
        -F "newPwdConfirm=${TARGET_PW}" \
        "${SLING_URL}/system/userManager/user/admin.changePassword.html")

if [ "$HTTP" != "200" ]; then
    echo "ERROR: changePassword returned HTTP $HTTP" >&2
    cat /tmp/sling-change.out >&2 || true
    exit 1
fi

# 4. Verify and persist
if ! works "$TARGET_PW"; then
    echo "ERROR: rotation reported 200 but new password does not authenticate" >&2
    exit 1
fi

umask 0177
printf '%s' "$TARGET_PW" > "$LAST_PW_FILE"
echo "CHANGED"
