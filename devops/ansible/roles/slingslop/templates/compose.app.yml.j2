# Managed by Ansible — slingslop/slingslop role.
# App stack: the Sling container backed by a named volume holding /content,
# /conf, /var, /home (composite NodeStore — /apps & /libs are baked into the
# image). See docs/composite-nodestore.md.

networks:
  default:
    name: {{ docker_network_name }}
    external: true

volumes:
  slingslop-content:

services:

  slingslop:
    image: {{ slingslop_image }}
    container_name: slingslop
    restart: unless-stopped
    # Give Oak time to flush + checkpoint on stop. Docker's default 10s can
    # SIGKILL Sling mid-flush on a redeploy, forcing a SegmentStore recovery on
    # next start that can drop the most recent (unflushed) writes. The feature
    # launcher runs as PID 1 (exec in launch.sh) and stops the framework
    # gracefully on SIGTERM, so a generous grace period protects content.
    stop_grace_period: 90s
    env_file:
      - {{ slingslop_secrets_dir }}/slingslop.env
    volumes:
      - slingslop-content:/opt/sling/launcher
    # Loopback-publish on a non-standard port so backup/probe scripts and
    # update playbooks can hit the app directly without going through Traefik.
    ports:
      - "127.0.0.1:18080:8080"
    deploy:
      resources:
        limits:
          cpus: "{{ slingslop_container_cpu_limit }}"
          memory: {{ slingslop_container_memory_limit }}
    security_opt:
      - no-new-privileges:true
    healthcheck:
      # The Sling image ships no wget/curl/nc, so probe via bash's /dev/tcp
      # (bash is present). Passes when /starter.html returns HTTP 200.
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080; printf 'GET /starter.html HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3; head -1 <&3 | grep -q 200"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: "{{ docker_log_max_size }}"
        max-file: "{{ docker_log_max_files | string }}"
    labels:
      traefik.enable: "true"
      # editor.<domain> → Sling author UI, gated by basicAuth + (optional) ipAllowList
      traefik.http.routers.editor.rule: "Host(`editor.{{ domain }}`)"
      traefik.http.routers.editor.entrypoints: "websecure"
{% if traefik_acme_enabled | default(true) | bool %}
      traefik.http.routers.editor.tls.certresolver: "letsencrypt"
{% else %}
      traefik.http.routers.editor.tls: "true"
{% endif %}
      traefik.http.routers.editor.service: "editor"
      traefik.http.routers.editor.middlewares: "sec-headers@file,editor-basicauth@file{% if editor_allowlist_cidrs | length > 0 %},editor-allowlist@file{% endif %}"
      traefik.http.services.editor.loadbalancer.server.port: "8080"
