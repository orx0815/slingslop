# Composite-mode image: extends the base Slingslop image with a pre-seeded
# read-only segment store for /apps and /libs.
#
# Build flow (see src/build/seed_and_bake.sh):
#   1. Build the base image with the regular Maven build.
#   2. Run the base image once with the slingslop_aggregate feature against a
#      throw-away local directory mounted as /opt/sling/launcher. Wait for
#      content installation to complete, then stop the container cleanly.
#   3. Copy the resulting repository/segmentstore into ./target/seed/segmentstore.
#   4. Build this Dockerfile, passing BASE_IMAGE.
#
# See docs/composite-nodestore.md.

ARG BASE_IMAGE=ghcr.io/orx0815/slingslop:snapshot
FROM ${BASE_IMAGE}

USER root
COPY --chown=sling:sling target/seed/segmentstore /opt/sling/seed-repository/segmentstore
USER sling:sling

CMD ["slingslop_composite_aggregate"]
