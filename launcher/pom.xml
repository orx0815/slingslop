<?xml version="1.0" encoding="ISO-8859-1"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <artifactId>slingslop.parent</artifactId>
    <groupId>org.motorbrot</groupId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>slingslop.launcher</artifactId>

  <name>Slingslop - Hypermedia PoC - Launcher</name>
  <description>
    This is a Module which contains a sample feature model build, built on top of the Sling Starter,
    that adds this project's artifacts. It also builds a docker image and runs integration-tests.
  </description>
  
  <properties>
    <slingslop.launcher.version>${project.version}</slingslop.launcher.version>
    <skipITs>false</skipITs>
    
    <!-- check docker.* at https://dmp.fabric8.io/ -->
    <docker.skip>true</docker.skip>
    <docker.skip.push>true</docker.skip.push>
    <docker.image.name>ghcr.io/orx0815/slingslop</docker.image.name>
    <docker.image.tag>snapshot</docker.image.tag>
    <!-- pass a list of platforms to enable multi-arch builds: linux/amd64,linux/arm64 -->
    <docker.platforms />
    
    <it.startTimeoutSeconds>60</it.startTimeoutSeconds>
    <starter.min.bundles.count>233</starter.min.bundles.count>
    <starter.check.paths>
      /content/slingslop/zengarden/home.html,
      /content/disco-dingo/home.html,
      /content/sling-matrix/home.html,
      /content/motorbrot/dma/home.html,
      /content/alf-vs-agent/home.html,
      /content/cyberpunk-alpaca/home.html,
      /content/sling-bench/home.html,
      /slingshot/users/slingshot1/travel/home/images/home.jpg,
      /slingshot/resources/images/background.jpg,
      /slingshot/users/slingshot2/places/landing/images/landing.jpg,
      /starter.html,
      /bin/browser.html,
      /system/console/bundles
    </starter.check.paths>
    <feature.launcher.plugin.version>1.0.4</feature.launcher.plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>4.5.14</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.utils</artifactId>
      <version>1.11.8</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.sling</groupId>
        <artifactId>slingfeature-maven-plugin</artifactId>
        <extensions>true</extensions>

        <configuration>
          <replacePropertyVariables>
            slingslop.launcher.version
          </replacePropertyVariables>
          <skipAddFeatureDependencies>true</skipAddFeatureDependencies>
          <framework>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.framework</artifactId>
            <version>${org.apache.felix.framework.version}</version>
          </framework>

          <!--
             Prepares a feature model aggregate that takes the following features from
             the Sling Starter:
             - nosample_base - the base Sling Starter
             - oak_persistence_sns - SegmentNodeStore persistence for Oak
             - composum - The Composum Nodes administration tool
             - slingshot
             - HTL Read-Eval-Print Loop
             - and starter samples for nicer login screen
          -->
          <aggregates>
            <aggregate>
              <classifier>slingslop_aggregate</classifier>
              <!-- launcher.json only; composite-nodestore.json is reserved for the composite aggregate. -->
              <filesInclude>launcher.json</filesInclude>
              <!--
                The Digital Media Library ships as a standalone, releasable Sling
                Feature Model. Here we dogfood the intended consumption pattern:
                a Sling-Starter-based launcher composes the DML feature in. A
                downstream project would instead reference the released artifact via
                <includeArtifact>org.motorbrot:slingslop.launcher:slingosgifeature:digitalmedia:VERSION</includeArtifact>.
              -->
              <filesInclude>digitalmedia.json</filesInclude>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>nosample_base</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>oak_persistence_sns</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>composum</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              
              <!-- needed for nicer login screen -->
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>starter</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              
              <!-- old demo -->
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>slingshot</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              
              <!-- HTL Read-Eval-Print Loop Environment -->
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>htl_repl</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              
            </aggregate>
            
            <!--
              Composite NodeStore aggregate (production Docker image).
              Identical to slingslop_aggregate, plus the composite-nodestore
              feature which flips persistence into composite mode:
                - /apps and /libs come from a read-only SegmentNodeStore that
                  lives in the image at /opt/sling/seed-repository
                - everything else lives in the read-write SegmentNodeStore
                  at /opt/sling/launcher/repository (the Docker volume)
              See docs/composite-nodestore.md for the rationale, the seeding
              workflow and the verification steps.
            -->
            <aggregate>
              <classifier>slingslop_composite_aggregate</classifier>
              <filesInclude>launcher.json</filesInclude>
              <filesInclude>composite-nodestore.json</filesInclude>
              <!-- Digital Media Library feature model (see slingslop_aggregate above). -->
              <filesInclude>digitalmedia.json</filesInclude>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>nosample_base</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>oak_persistence_sns</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>composum</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>starter</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>slingshot</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              <includeArtifact>
                <groupId>org.apache.sling</groupId>
                <artifactId>org.apache.sling.starter</artifactId>
                <classifier>htl_repl</classifier>
                <version>${sling.starter.version}</version>
                <type>slingosgifeature</type>
              </includeArtifact>
              
              <!--
                The composite-nodestore feature itself is brought in via the
                <filesInclude> above. We tell the slingfeature aggregator to
                merge the SegmentNodeStoreService config of both contributors
                (oak_persistence_sns provides "name" etc., composite-nodestore
                contributes "role=composite-global"). Latest wins for any
                clashing property keys.
              -->
              <configurationOverrides>
                <configurationOverride>org.apache.jackrabbit.oak.segment.SegmentNodeStoreService=MERGE_LATEST</configurationOverride>
              </configurationOverrides>
            </aggregate>
          </aggregates>
          
          <scans>
            <scan>
              <includeClassifier>slingslop_aggregate</includeClassifier>
            </scan>
            <scan>
              <includeClassifier>slingslop_composite_aggregate</includeClassifier>
            </scan>
          </scans>
          
        </configuration>
        
        <executions>
          <execution>
            <id>prepare-features</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>aggregate-features</goal>
              <goal>analyse-features</goal>
              <goal>attach-features</goal>
            </goals>
          </execution>
          
          <!-- For Dockerfile's COPY target/artifacts /opt/sling/artifacts/ -->
          <execution>
            <id>create-repository</id>
            <phase>package</phase>
            <goals>
              <!-- A maven-like directory with all artifacts from the selected features will be created -->
              <goal>repository</goal>
            </goals>
            <configuration>
              <repositories>
                <repository>
                  <includeClassifier>slingslop_aggregate</includeClassifier>
                  <includeClassifier>slingslop_composite_aggregate</includeClassifier>
                  <includeArtifact>
                    <groupId>org.apache.sling</groupId>
                    <artifactId>org.apache.sling.starter</artifactId>
                    <!-- Needed for proper logging to stdout -->
                    <classifier>docker</classifier>
                    <version>${sling.starter.version}</version>
                    <type>slingosgifeature</type>
                  </includeArtifact>
                </repository>
              </repositories>
            </configuration>
          </execution>
          
        </executions>
      </plugin>
      
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-feature-launcher</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.apache.sling</groupId>
                  <artifactId>org.apache.sling.feature.launcher</artifactId>
                  <version>${org.apache.sling.feature.launcher.version}</version>
                  <type>tar.gz</type>
                  <!-- remove the version number from the unpacked folder -->
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      <pattern>\Qorg.apache.sling.feature.launcher-${org.apache.sling.feature.launcher.version}\E</pattern>
                      <replacement>org.apache.sling.feature.launcher</replacement>
                    </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>

          <!-- Sample-content is NOT in the feature/seed (code-only image). Stage the
               demo packages into the Docker context; install-sample-content.sh installs
               them into the RUNNING Sling on every launch/deploy (see launch.sh + the
               slingslop role's install-sample-content task). -->
          <execution>
            <id>stage-sample-content</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/sample-content</outputDirectory>
              <stripVersion>true</stripVersion>
              <artifactItems>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>slingslop.zengarden.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>disco-dingo.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>slingslop.alf-vs-agent.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>cyberpunk-alpaca.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>slingslop.sling-matrix.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>digitalmedia.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.motorbrot</groupId>
                  <artifactId>sling-bench.sample-content</artifactId>
                  <version>${slingslop.launcher.version}</version>
                  <type>zip</type>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <version>0.48.1</version>
        <configuration>
          <skip>${docker.skip}</skip>
          <skipPush>${docker.skip.push}</skipPush>
          <containerNamePattern>%e</containerNamePattern>
          <stopMode>kill</stopMode>
        </configuration>
        <executions>
          <execution>
            <id>build-docker-image</id>
            <phase>package</phase>
            <goals>
              <goal>build</goal>
              <!-- -D docker.skip.push=false -->
              <goal>push</goal>
            </goals>
            <configuration>
              <!-- Configure the sling image only for build, we don't want to run it  -->
              <images>
                <image>
                  <name>${docker.image.name}:${docker.image.tag}</name>
                  <build>
                    <dockerFile>Dockerfile</dockerFile>
                    <contextDir>${project.basedir}</contextDir>
                    <tags>
                      <tag>${docker.image.extra.tag}</tag>
                    </tags>
                    <buildx>
                      <platforms>
                        <platform>${docker.platforms}</platform>
                      </platforms>
                    </buildx>
                  </build>
                </image>
              </images>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>reserve-http-port</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>reserve-network-port</goal>
            </goals>
            <configuration>
              <portNames>
                <portName>http.port</portName>
              </portNames>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.sling</groupId>
        <artifactId>feature-launcher-maven-plugin</artifactId>
        <version>${feature.launcher.plugin.version}</version>
        <configuration>
          <launches>
            <launch>
              <id>slingslop-aggregate</id>
              <feature>
                <groupId>${project.groupId}</groupId>
                <artifactId>${project.artifactId}</artifactId>
                <version>${project.version}</version>
                <classifier>slingslop_aggregate</classifier>
                <type>slingosgifeature</type>
              </feature>
              <launcherArguments>
                <frameworkProperties>
                  <org.osgi.service.http.port>${http.port}</org.osgi.service.http.port>
                </frameworkProperties>
              </launcherArguments>
              <startTimeoutSeconds>${it.startTimeoutSeconds}</startTimeoutSeconds>
            </launch>
          </launches>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>start</goal>
              <goal>stop</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <!-- Sample-content is not in the feature (code-only image); install it into
               the just-launched single-store instance so the IT content checks pass.
               Declared AFTER feature-launcher so 'start' runs first; skipped with the ITs. -->
          <execution>
            <id>install-sample-content-for-it</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipITs}</skip>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/src/main/container/bin/install-sample-content.sh</argument>
              </arguments>
              <environmentVariables>
                <SLING_URL>http://localhost:${http.port}</SLING_URL>
                <SLING_USER>admin</SLING_USER>
                <SLING_PASSWORD>admin</SLING_PASSWORD>
                <SAMPLE_CONTENT_DIR>${project.build.directory}/sample-content</SAMPLE_CONTENT_DIR>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
            <include>**/*Test.java</include>
          </includes>
          <systemPropertyVariables>
            <launchpad.http.server.url>http://localhost:${http.port}/</launchpad.http.server.url>
            <starter.http.test.ports>false:${http.port}</starter.http.test.ports>
            <starter.min.bundles.count>${starter.min.bundles.count}</starter.min.bundles.count>
            <starter.check.paths>${starter.check.paths}</starter.check.paths>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
            
    </plugins>
  </build>

  <profiles>
    <!--
      Activated by '-Pcomposite-image'. Builds a derived Docker image with a
      pre-seeded read-only segment store for /apps and /libs (composite
      NodeStore mode). Requires -Ddocker.skip=false so the base image exists.
      See docs/composite-nodestore.md.

      Usage:
        mvn clean install -Ddocker.skip=false -Pcomposite-image

      Produces:
        ${docker.image.name}:${docker.image.tag}             (base, single-store, unchanged)
        ${docker.image.name}:${docker.image.tag}-composite   (composite NodeStore)
    -->
    <profile>
      <id>composite-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>seed-and-bake-composite-image</id>
                <!-- After docker-maven-plugin's 'build' execution (also bound to package). -->
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${docker.skip}</skip>
                  <executable>${project.basedir}/seed_and_bake.sh</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <environmentVariables>
                    <IMAGE_BASE>${docker.image.name}:${docker.image.tag}</IMAGE_BASE>
                    <IMAGE_OUT>${docker.image.name}:${docker.image.tag}-composite</IMAGE_OUT>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
