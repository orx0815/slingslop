<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="sling:Folder"
    sling:resourceType="sling-matrix/pages/page">
    <jcr:content
        jcr:primaryType="nt:unstructured"
        jcr:title="Welcome to Sling Matrix"
        sling:resourceType="sling-matrix/pages/homepage">
        <hero
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/hero"
            heroText="\ud83d\udcbb Sling"
            subtitle="Enter the world of Apache Sling - where content meets code"
            title="Welcome to the Matrix"/>
        <main
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/parsys"
            allowedComponents="[code-block,feature-image,slide-headline,text-block]">
            <slide-headline-1
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/slide-headline"
                headline="What is Sling Matrix?"/>
            <text-block-1
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/text-block"
                text="&lt;p>Sling Matrix is your gateway to mastering Apache Sling. Like Neo awakening to the true nature of reality, you'll discover the power beneath the surface of web content management.&lt;/p>&lt;p>This documentation will guide you through the fundamental concepts of OSGi, JCR, and Sling - the three pillars that support the Matrix of modern content-driven applications.&lt;/p>&lt;p>Strangely there is no content here yet …&lt;/p>"/>
            <feature_image
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/feature-image"
                dmaAlt="Follow the White Rabbit"
                dmaFocusX="{Double}50.83"
                dmaFocusY="{Double}49.1"
                dmaFormats="[matrix-feature-desktop,matrix-feature-mobile]"
                dmaMedia="[(min-width: 768px)]"
                fileReference="/content/motorbrot/dml/assets/slingslop/matrix/jackrabbits/follow_the_white_jackrabbit_4.png"
                headline="Follow the White Rabbit"
                imagePosition="right"
                text="&lt;p>Ready to see how deep the rabbit hole goes? Explore our documentation sections to unlock the secrets of Apache Sling:&lt;/p>&lt;ul>&lt;li>&lt;p>&lt;a target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; href=&quot;./home/osgi/osgi-intro.html&quot;>&lt;strong>OSGi&lt;/strong>&lt;/a> - The modular foundation of the Matrix&lt;/p>&lt;/li>&lt;li>&lt;p>&lt;a target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; href=&quot;./home/jcr/jcr-intro.html&quot;>&lt;strong>JCR&lt;/strong>&lt;/a> - The repository that stores all truth&lt;/p>&lt;/li>&lt;li>&lt;p>&lt;a target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; href=&quot;./home/sling/sling-intro.html&quot;>&lt;strong>Sling&lt;/strong>&lt;/a> - The framework that brings it all together&lt;/p>&lt;/li>&lt;/ul>">
                <renditions jcr:primaryType="nt:unstructured">
                    <matrix-feature-desktop_cropped/>
                </renditions>
            </feature_image>
        </main>
        <footer
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/footer"
            copyright="© 2026 Sling Matrix"
            link1Title="Apache Sling"
            link1Url="https://sling.apache.org"
            link2Title="Documentation"
            link2Url="/content/sling-matrix/home/osgi/osgi-intro.html"
            link3Title="GitHub"
            link3Url="https://github.com/apache/sling"/>
