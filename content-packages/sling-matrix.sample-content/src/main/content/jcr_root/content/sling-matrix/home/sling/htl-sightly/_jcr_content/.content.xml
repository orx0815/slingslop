<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="HTL (Sightly)"
    sling:resourceType="sling-matrix/pages/contentpage">
    <main
        jcr:primaryType="nt:unstructured"
        sling:resourceType="sling-matrix/components/parsys">
        <slide-headline-1
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="What is HTL?"/>
        <text-block-1
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/text-block"
            text="&lt;p&gt;HTL (HTML Template Language, formerly known as Sightly) is a scripting language invented by Adobe specifically for Sling:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Recommended default scripting language&lt;/li&gt;&lt;li&gt;Enforces clean separation of presentation and logic — only simple logic constructs in template&lt;/li&gt;&lt;li&gt;Intelligent XSS support built-in&lt;/li&gt;&lt;li&gt;Good integration with Sling&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;File extension: &lt;code&gt;.html&lt;/code&gt;. Each HTML file is a valid HTL file. Data logic is added using &lt;code&gt;data-sly-*&lt;/code&gt; attributes and &lt;code&gt;${}&lt;/code&gt; expressions.&lt;/p&gt;"/>
        <slide-headline-2
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Expressions"/>
        <text-block-2
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/text-block"
            text="&lt;p&gt;HTL expressions &lt;code&gt;${}&lt;/code&gt; access variables and their properties:&lt;/p&gt;&lt;pre&gt;${currentPage.title}&#xA;${properties.jcr:title}&#xA;${properties['jcr:title']}&lt;/pre&gt;&lt;p&gt;Supported: string, number, boolean, array literals. Operators: logical (&amp;amp;&amp;amp;, ||, !), comparison (&amp;lt;, &amp;gt;, ==), ternary (&lt;code&gt;? :&lt;/code&gt;), grouping.&lt;/p&gt;"/>
        <slide-headline-3
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Expression Options"/>
        <text-block-3
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/text-block"
            text="&lt;p&gt;Expression options modify the output. Syntax: &lt;code&gt;${expression @ option1='value', option2='value'}&lt;/code&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;code&gt;@ i18n&lt;/code&gt; — translate string&lt;/li&gt;&lt;li&gt;&lt;code&gt;@ format&lt;/code&gt; — format with placeholders&lt;/li&gt;&lt;li&gt;&lt;code&gt;@ join&lt;/code&gt; — join array with separator&lt;/li&gt;&lt;li&gt;&lt;code&gt;@ context&lt;/code&gt; — set display/XSS context&lt;/li&gt;&lt;li&gt;&lt;code&gt;@ scheme, domain, path, extension, selectors, query, fragment&lt;/code&gt; — URI manipulation&lt;/li&gt;&lt;/ul&gt;"/>
        <slide-headline-4
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Display Context and XSS Prevention"/>
        <text-block-4
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/text-block"
            text="&lt;p&gt;HTL applies automatic context-aware XSS escaping. It detects HTML, attributes, URIs, JavaScript, CSS contexts:&lt;/p&gt;&lt;pre&gt;${properties.jcr:title}             &amp;lt;!-- auto-detected: text context --&amp;gt;&#xA;${properties.richText @ context='html'}  &amp;lt;!-- explicit: allow safe HTML --&amp;gt;&#xA;${properties.link @ context='uri'}       &amp;lt;!-- explicit: URI context --&amp;gt;&lt;/pre&gt;&lt;p&gt;Available contexts: text, html, attribute, uri, number, scriptToken, scriptString, scriptComment, styleToken, styleString, styleComment, unsafe.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Warning:&lt;/strong&gt; &lt;code&gt;unsafe&lt;/code&gt; disables all XSS protection. Use only in exceptional cases.&lt;/p&gt;"/>
        <slide-headline-5
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Test and List Statements"/>
        <code-block-1
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/code-block"
            language="html"
            code="&lt;!--/* data-sly-test: conditional rendering */--&gt;&#xa;&lt;p data-sly-test=&quot;${properties.showText}&quot;&gt;Text to show&lt;/p&gt;&#xa;&lt;p data-sly-test=&quot;${!properties.showText}&quot;&gt;Fallback text&lt;/p&gt;&#xa;&#xa;&lt;!--/* Saving test result to variable */--&gt;&#xa;&lt;p data-sly-test.hasTitle=&quot;${properties.jcr:title}&quot;&gt;has title&lt;/p&gt;&#xa;&lt;p data-sly-test=&quot;${!hasTitle}&quot;&gt;no title&lt;/p&gt;&#xa;&#xa;&lt;!--/* data-sly-list: iterate over items */--&gt;&#xa;&lt;ul data-sly-list.child=&quot;${resource.listChildren}&quot;&gt;&#xa;  &lt;li&gt;${child.name} (index: ${childList.index})&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&#xa;&lt;!--/* data-sly-repeat: like list but keeps host element */--&gt;&#xa;&lt;div data-sly-repeat.child=&quot;${resource.listChildren}&quot;&gt;&#xa;  ${child.name}&#xa;&lt;/div&gt;"/>
        <slide-headline-6
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Template and Call Statements"/>
        <code-block-2
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/code-block"
            language="html"
            code="&lt;!--/* Define template with parameters */--&gt;&#xa;&lt;template data-sly-template.card=&quot;${@ title, description}&quot;&gt;&#xa;  &lt;div class=&quot;card&quot;&gt;&#xa;    &lt;h3&gt;${title}&lt;/h3&gt;&#xa;    &lt;p&gt;${description}&lt;/p&gt;&#xa;  &lt;/div&gt;&#xa;&lt;/template&gt;&#xa;&#xa;&lt;!--/* Call template */--&gt;&#xa;&lt;sly data-sly-call=&quot;${card @ title='Neo', description='The One'}&quot;/&gt;&#xa;&#xa;&lt;!--/* Include template library from separate file */--&gt;&#xa;&lt;sly data-sly-use.lib=&quot;templateLib.html&quot;&#xa;     data-sly-call=&quot;${lib.card @ title='Morpheus', description='Captain'}&quot;/&gt;&#xa;&#xa;&lt;!--/* Recursive example (site map) */--&gt;&#xa;&lt;template data-sly-template.listChildren=&quot;${@ page}&quot;&#xa;         data-sly-list=&quot;${page.listChildren}&quot;&gt;&#xa;  &lt;li&gt;&#xa;    &lt;div class=&quot;title&quot;&gt;${item.title}&lt;/div&gt;&#xa;    &lt;ol data-sly-call=&quot;${listChildren @ page=item}&quot;&gt;&lt;/ol&gt;&#xa;  &lt;/li&gt;&#xa;&lt;/template&gt;"/>
        <slide-headline-7
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Unwrap, Element, Attribute, and Text Statements"/>
        <code-block-3
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/code-block"
            language="html"
            code="&lt;!--/* data-sly-unwrap: conditionally remove outer element */--&gt;&#xa;&lt;div class=&quot;editable&quot; data-sly-unwrap=&quot;${!wcmmode.edit}&quot;&gt;&#xa;  text&#xa;&lt;/div&gt;&#xa;&#xa;&lt;!--/* data-sly-element: change element name */--&gt;&#xa;&lt;h1 data-sly-element=&quot;${titleElement}&quot;&gt;Title&lt;/h1&gt;&#xa;&lt;!-- Output: &lt;h3&gt;Title&lt;/h3&gt; (if titleElement = 'h3') --&gt;&#xa;&#xa;&lt;!--/* data-sly-attribute: set attributes */--&gt;&#xa;&lt;input data-sly-attribute=&quot;${keyValueMapOfAttributes}&quot;/&gt;&#xa;&lt;!-- Output: &lt;input type=&quot;text&quot; name=&quot;firstName&quot; value=&quot;Alison&quot;/&gt; --&gt;&#xa;&#xa;&lt;!--/* Single attribute with identifier */--&gt;&#xa;&lt;a href=&quot;#&quot; data-sly-attribute.href=&quot;${link}&quot;&gt;link&lt;/a&gt;&#xa;&#xa;&lt;!--/* data-sly-text: replace element content */--&gt;&#xa;&lt;div data-sly-text=&quot;${content}&quot;&gt;Lorem ipsum&lt;/div&gt;"/>
        <slide-headline-8
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Use Statement"/>
        <code-block-4
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/code-block"
            language="html"
            code="&lt;!--/* Java (Sling Model) example: */--&gt;&#xa;&lt;div data-sly-use.logic=&quot;org.matrix.SentinelModel&quot;&gt;&#xa;  ${logic.status}&#xa;&lt;/div&gt;&#xa;&#xa;&lt;!--/* JavaScript Use API: */--&gt;&#xa;&lt;div data-sly-use.logic=&quot;${'logic.js' @ param1='Matrix'}&quot;&gt;&#xa;  ${logic.hi}&#xa;&lt;/div&gt;&#xa;&#xa;&lt;!--/* logic.js */--&gt;&#xa;&lt;!--/*&#xa;use(function () {&#xa;  return {&#xa;    hi: &quot;Hello &quot; + this.param1&#xa;  };&#xa;});&#xa;*/--&gt;&#xa;&#xa;&lt;!--/* Resource object (exposes properties) — since HTL 1.2 */--&gt;&#xa;&lt;div data-sly-use.nav=&quot;./navigation&quot;&gt;&#xa;  ${nav.title}&#xa;&lt;/div&gt;"/>
        <slide-headline-9
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/slide-headline"
            headline="Use Statement — Best Practices"/>
        <text-block-5
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/text-block"
            text="&lt;ul&gt;&lt;li&gt;Don't use data-sly-use when not needed — if you only read properties and need simple logic, use HTL directly&lt;/li&gt;&lt;li&gt;Don't include the same Java/JS object multiple times — declare once at top and reuse&lt;/li&gt;&lt;li&gt;Don't always use 1:1 relation between script and controller — define controllers per aspect of functionality&lt;/li&gt;&lt;li&gt;A HTL script can use multiple data-sly-use statements for different aspects&lt;/li&gt;&lt;li&gt;Recommended: Sling Models as controllers (not WCMUse or raw Java classes)&lt;/li&gt;&lt;/ul&gt;"/>
    </main>
</jcr:root>
