<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="sling:Folder"
    sling:resourceType="sling-matrix/pages/page">
    <jcr:content
        jcr:primaryType="nt:unstructured"
        jcr:title="Slingslop Architecture"
        sling:resourceType="sling-matrix/pages/contentpage">
        <main
            jcr:primaryType="nt:unstructured"
            sling:resourceType="sling-matrix/components/parsys"
            allowedComponents="[architecture-diagram,code-block,slide-headline,text-block]">
            <slide-headline-1
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/slide-headline"
                headline="Slingslop Architecture"/>
            <text-block-1
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/text-block"
                text="&lt;p>A generated, checked system map of the whole Slingslop stack: the public request path (Traefik &amp;rarr; webcache &amp;rarr; Sling &amp;rarr; Oak JCR), CI/CD (GitHub Actions &amp;rarr; GHCR &amp;rarr; Ansible deploy), and observability (Prometheus/Loki &amp;rarr; Grafana). Pan, zoom, and switch light/dark theme below &amp;mdash; this is a static, read-only embed, not an editable component.&lt;/p>"/>
            <architecture-diagram-1
                jcr:primaryType="nt:unstructured"
                sling:resourceType="sling-matrix/components/architecture-diagram"
                headline="Interactive system map"/>
        </main>
    </jcr:content>
</jcr:root>
