<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="sling:Folder"
    sling:resourceType="ratml/pages/page">
    <jcr:content
        jcr:primaryType="nt:unstructured"
        jcr:title="Style Guide"
        sling:resourceType="ratml/pages/styleguide">
        <main
            jcr:primaryType="nt:unstructured"
            sling:resourceType="ratml/components/parsys"
            allowedComponents="[text-block,pull-quote]">
            <demo-text-block
                jcr:primaryType="nt:unstructured"
                sling:resourceType="ratml/components/text-block"
                headline="Text Block Demo"
                text="&lt;p>A live &lt;strong>text-block&lt;/strong> component with a headline, a drop cap, &lt;em>emphasis&lt;/em>, a &lt;a href=&quot;/content/ratml/home.html&quot;>link&lt;/a> and inline &lt;code>code&lt;/code>. Log in and click to edit it inline with the rich-text editor.&lt;/p>"/>
            <demo-pull-quote
                jcr:primaryType="nt:unstructured"
                sling:resourceType="ratml/components/pull-quote"
                quote="This is a pull-quote component. It shouts."
                attribution="The style guide"/>
        </main>
    </jcr:content>
</jcr:root>
