      "type": "timeseries",
      "title": "Container RSS (MiB)",
      "datasource": "Prometheus",
      "targets": [{"expr": "container_memory_rss{name!=\"\"} / 1024 / 1024", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "logs",
      "title": "Slingslop logs (Loki)",
      "datasource": "Loki",
      "targets": [{"expr": "{compose_service=\"slingslop\"}", "refId": "A"}],
