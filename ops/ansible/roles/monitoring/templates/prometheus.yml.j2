# Managed by Ansible — slingslop/monitoring role.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:

  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  # Sling exposes /system/console/status-Configurations under HTTP basic auth
  # — not Prometheus-formatted. We don't scrape Sling natively here; container
  # metrics from cAdvisor are usually enough. Add a JMX exporter sidecar later
  # if you want JVM internals.
