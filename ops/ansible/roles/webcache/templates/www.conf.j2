# Managed by Ansible — slingslop/webcache role.
# Adapted from docker/webcache/www.conf — domain parameterised.

<VirtualHost *:80>

   ServerName www.{{ domain }}
   ServerAlias {{ domain }}
   DocumentRoot /var/www/vhosts/www
   ErrorLog /var/log/apache2/wwwerr.log
   TransferLog /var/log/apache2/www-access.log
   DirectoryIndex index.html

   RewriteEngine on
   RewriteRule "^/content/sling-matrix(.*)$" "$1" [PT]

   # Configure mod_cache
   CacheEnable disk /
   CacheIgnoreNoLastMod On
   CacheIgnoreCacheControl On
   # Cache one entry per PATH, ignoring the query string. The full request
   # (incl. query) is still forwarded to Sling on a MISS, so Sling sees the
   # params — but every ?v=... (ours) and ?x=rnd (attacker) shares one cache
   # entry: cache-buster-safe AND immune to query-string cache-bypass DoS.
   CacheIgnoreQueryString On
   CacheRoot /var/cache/httpd/slingslop
   CacheDefaultExpire 10
   CacheHeader On
   CacheDetailHeader On

   # Configure mod_expire
   ExpiresActive On
   ExpiresDefault "access plus 1 month"
   ExpiresByType text/html "access plus 5 seconds"
   ExpiresByType application/json "access plus 10 seconds"
   ExpiresByType image/gif "access plus 1 year"
   ExpiresByType image/jpeg "access plus 1 year"
   ExpiresByType image/png "access plus 1 year"
   ExpiresByType text/css "access plus 1 month"
   ExpiresByType text/javascript "access plus 1 month"
   ExpiresByType application/javascript "access plus 1 month"

   # Configure Proxy
   ProxyPassInterpolateEnv On
   ProxyPass /.well-known !
   ProxyPass /ERROR !

   # Well-known paths that need to pass through unmolested
   ProxyPass /apps/sling-matrix/ http://${RENDERER_URL}:8080/apps/sling-matrix/ connectiontimeout=10 timeout=60 retry=0 interpolate
   # Cache-busting clientlib servlet (versioned JS/CSS). Must precede the catch-all
   # below, which would otherwise rewrite it under /content/sling-matrix.
   ProxyPass /bin/public/ http://${RENDERER_URL}:8080/bin/public/ connectiontimeout=10 timeout=60 retry=0 interpolate
   ProxyPass /favicon.ico http://${RENDERER_URL}:8080/apps/sling-matrix/favicon.ico connectiontimeout=10 timeout=60 retry=0 interpolate

   # Without path -> home.html  (homepage node is /content/sling-matrix/home)
   ProxyPassMatch "^/$" "http://${RENDERER_URL}:8080/content/sling-matrix/home.html" connectiontimeout=10 timeout=60 retry=0 interpolate

   # When path does NOT start with /content/sling-matrix, assume URL
   # shortening has worked and make it long again before requesting Sling
   ProxyPassMatch "^(?!(\/content)?\/sling-matrix)/(.*)" "http://${RENDERER_URL}:8080/content/sling-matrix/$2" connectiontimeout=10 timeout=60 retry=0 interpolate

   ProxyPass /content/sling-matrix/ http://${RENDERER_URL}:8080/content/sling-matrix/ connectiontimeout=10 timeout=60 retry=0 interpolate
   ProxyPass /sling-matrix/         http://${RENDERER_URL}:8080/content/sling-matrix/ connectiontimeout=10 timeout=60 retry=0 interpolate
   ProxyPassReverse /content/sling-matrix/ http://${RENDERER_URL}:8080/content/sling-matrix/ interpolate
   ProxyPassReverse /home.html/404 http://${RENDERER_URL}:8080/system/sling/form/login interpolate

   # Security / Hardening
   AllowEncodedSlashes on
   RewriteRule "^.+\..*\.json" - [F,L]
   RewriteCond %{REQUEST_METHOD} ^(delete|post|trace|track) [NC]
   RewriteRule .* - [F,L]
   Header set X-Frame-Options SAMEORIGIN
   Header set X-XSS-Protection "1; mode=block"
   Header set X-Content-Type-Options "nosniff"

   AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json

</VirtualHost>
