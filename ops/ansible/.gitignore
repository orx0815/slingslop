.ansible-facts/
inventory/hosts.yml
# NOTE: inventory/group_vars/all/vault.yml IS committed on purpose and is
# byte-identical on every branch (main, feature, deploy). It must be
# ansible-vault ENCRYPTED (first line: "$ANSIBLE_VAULT;1.1;AES256") — committing
# the encrypted blob is what makes the GitOps deploy work in CI; security rests
# on the passphrase (the ANSIBLE_VAULT_PASSWORD secret), never the ciphertext.
# Do NOT ignore it here, and never commit a decrypted vault.
inventory/host_vars/slingslop-prod.yml
*.retry
