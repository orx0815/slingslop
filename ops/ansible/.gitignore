.ansible-facts/
inventory/hosts.yml
# NOTE: the REAL prod vault is inventory/group_vars/slingslop/vault.yml, committed
# ONLY on the deploy/motorbrot_prod branch (a path main/feature branches never
# carry, so a merge from main can't clobber it, and it never leaks onto main). It
# must be ansible-vault ENCRYPTED (first line: "$ANSIBLE_VAULT;1.1;AES256") —
# committing the encrypted blob is what makes the GitOps deploy work in CI.
# `main` carries NO vault (only vault.example.yml). Do NOT ignore the real vault
# here, and never commit a decrypted vault.
inventory/host_vars/slingslop-prod.yml
*.retry
